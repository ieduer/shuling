{
  "name": "shuling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-bank.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "build": "npm run build:data && npm run check && vite build",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "worker:dev": "wrangler dev --local"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "8.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "wrangler": "^4.100.0"
  }
}
